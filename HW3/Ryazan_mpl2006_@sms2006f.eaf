        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a34"
                TIME_SLOT_REF1="ts63" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>и / мне ниче не сдел= / мне не приложили ни хол= / ну / ничего мне не дали</ANNOTATION_VALUE>
